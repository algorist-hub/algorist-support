<header class="chat-header">
    @* The visible name is in the brand bar; this heading keeps the page navigable for screen readers and FocusOnNavigate. *@
    <h1 class="visually-hidden">@AssistantName</h1>
    <p class="chat-notice" role="note">
        <strong>Demonstração:</strong> este é um assistente automatizado de demonstração.
        As respostas tratam de uma
        <a class="chat-policy-link" href="politica" target="_blank" rel="noopener noreferrer">política fictícia<span class="visually-hidden"> (abre em nova janela)</span></a>,
        criada apenas para fins ilustrativos.
        Repositório do projeto:
        <a class="chat-repo-link" href="@RepositoryUrl" target="_blank" rel="noopener noreferrer">@RepositoryUrl<span class="visually-hidden"> (abre em nova janela)</span></a>
    </p>
</header>

@code {
    /// <summary>Public source repository of this project, linked from the demo notice.</summary>
    public const string RepositoryUrl = "https://github.com/algorist-hub/algorist-support";

    [Parameter, EditorRequired]
    public string AssistantName { get; set; } = string.Empty;
}
