<ol class="chat-messages" role="log" aria-label="Mensagens da conversa">
    @foreach (var entry in Entries)
    {
        <li @key="entry.Id" class="chat-message @(entry.IsUser ? "chat-message-user" : "chat-message-assistant")">
            <span class="visually-hidden">@(entry.IsUser ? "Você" : AssistantName) disse:</span>
            <div class="chat-bubble">
                @if (entry.Length > 0)
                {
                    @if (entry.IsUser)
                    {
                        <span class="chat-text">@entry.Text</span>
                    }
                    else
                    {
                        @* Assistant replies are Markdown; SafeMarkdown escapes raw HTML and drops unsafe URLs. *@
                        <div class="chat-text chat-markdown">@SafeMarkdown.ToHtml(entry.Text)</div>
                    }
                }
                @if (entry.Status == ChatEntryStatus.Interrupted)
                {
                    <span class="chat-status">Resposta interrompida</span>
                }
                else if (entry.Status == ChatEntryStatus.Failed)
                {
                    <span class="chat-status chat-status-error">Desculpe, não foi possível gerar a resposta. Tente novamente.</span>
                    @if (CanRetry && ReferenceEquals(entry, Entries[^1]))
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm chat-retry" @onclick="OnRetry">Tentar novamente</button>
                    }
                }
            </div>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ChatEntry> Entries { get; set; } = [];

    [Parameter, EditorRequired]
    public string AssistantName { get; set; } = string.Empty;

    /// <summary>When true, the last entry (if it is a failed reply) shows the "Tentar novamente" button.</summary>
    [Parameter]
    public bool CanRetry { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
