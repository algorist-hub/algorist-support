@* Site-wide brand bar, styled like the header of algorist.com.br. Outside <main>, so it is the page's banner landmark. *@
<header class="brand-bar">
    <a class="brand-link" href="@CompanySiteUrl" target="_blank" rel="noopener noreferrer">
        <img class="brand-logo" src="brand/logo.png" alt="Algorist" width="136" height="40" /><span class="visually-hidden"> (abre em nova janela)</span>
    </a>
</header>

@code {
    /// <summary>The company website the logo links to.</summary>
    public const string CompanySiteUrl = "https://algorist.com.br";
}
